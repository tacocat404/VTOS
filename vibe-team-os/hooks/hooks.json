{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          { "type": "command", "command": "${CLAUDE_PLUGIN_ROOT}/scripts/restore_context.sh" }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          { "type": "command", "command": "${CLAUDE_PLUGIN_ROOT}/scripts/count_turns.sh" }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          { "type": "command", "command": "${CLAUDE_PLUGIN_ROOT}/scripts/checkpoint_gate.sh", "timeout": 30 }
        ]
      }
    ],
    "PreCompact": [
      {
        "hooks": [
          { "type": "command", "command": "${CLAUDE_PLUGIN_ROOT}/scripts/checkpoint_gate.sh", "args": ["--force"] }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          { "type": "command", "if": "Bash(git push*)", "command": "${CLAUDE_PLUGIN_ROOT}/scripts/scan_secrets.sh" },
          { "type": "command", "if": "Bash(git push*)", "command": "${CLAUDE_PLUGIN_ROOT}/scripts/check_sensitive.sh" }
        ]
      }
    ]
  }
}
